GEIDEA_ENVIRONMENT=production

# مفاتيح بيئة الاختبار والتطوير (Sandbox)
GEIDEA_TEST_MERCHANT_PUBLIC_KEY=
GEIDEA_TEST_API_PASSWORD=

# روابط الرد والتحويل
GEIDEA_CALLBACK_URL=https://capital-talabat.vercel.app/api/geidea/callback
GEIDEA_RETURN_URL=https://capital-talabat.vercel.app/checkout/success

# ──────────────────────────────────────────────────────────────────────────────
# 7️⃣ CHATAMAN WHATSAPP GATEWAY (بوابة شات أمان لرسائل الواتساب وقوالب الإشعارات)
# ──────────────────────────────────────────────────────────────────────────────
CHATAMAN_API_KEY=
CHATAMAN_BASE_URL=https://chataman.com
CHATAMAN_SENDER_NAME=طلبات العاصمة
CHATAMAN_DEFAULT_COUNTRY_CODE=20
CHATAMAN_WEBHOOK_URL=https://capital-talabat.vercel.app/api/chataman/webhook


# OSM: public endpoints are development defaults only; choose production providers explicitly.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Browser routing remains same-origin and authenticated; no provider key belongs here.
VITE_OSRM_URL=/api/osm/route
OSRM_URL=
NOMINATIM_URL=
NOMINATIM_USER_AGENT=
# minLongitude,minLatitude,maxLongitude,maxLatitude — development example, review service area.
OSM_ALLOWED_BBOX=31.50,29.85,31.95,30.20
