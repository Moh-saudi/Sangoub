rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'el7lm25@gmail.com'
      );
    }

    // 3. Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'fullName',
        'email',
        'phone',
        'ministry',
        'floorNumber',
        'roomNumber',
        'role',
        'walletBalance',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'fullName',
        'email',
        'phone',
        'ministry',
        'floorNumber',
        'roomNumber',
        'role',
        'walletBalance',
        'avatarUrl',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
      data.ministry is string && data.ministry.size() >= 1 && data.ministry.size() <= 120 &&
      data.floorNumber is string && data.floorNumber.size() >= 1 && data.floorNumber.size() <= 60 &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 80 &&
      data.role is string && data.role in ['employee', 'restaurant', 'courier', 'admin'] &&
      data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 100000 &&
      (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Validation Blueprint: OrderRecord (/orders/{orderId})
    function isValidOrderRecord(data) {
      return data.keys().hasAll([
        'orderNumber',
        'profileId',
        'profileName',
        'phone',
        'ministry',
        'floorNumber',
        'roomNumber',
        'itemsSummary',
        'total',
        'paymentMethod',
        'orderStatus',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderNumber',
        'profileId',
        'profileName',
        'phone',
        'ministry',
        'floorNumber',
        'roomNumber',
        'itemsSummary',
        'total',
        'paymentMethod',
        'orderStatus',
        'scheduledDeliveryTime',
        'createdAt',
        'updatedAt'
      ]) &&
      data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 40 &&
      data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.profileName is string && data.profileName.size() >= 1 && data.profileName.size() <= 120 &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
      data.ministry is string && data.ministry.size() >= 1 && data.ministry.size() <= 120 &&
      data.floorNumber is string && data.floorNumber.size() >= 1 && data.floorNumber.size() <= 60 &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 80 &&
      data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 1000 &&
      data.total is number && data.total >= 0 && data.total <= 100000 &&
      data.paymentMethod is string && data.paymentMethod in ['instapay', 'geidea', 'cash'] &&
      data.orderStatus is string && data.orderStatus in ['received', 'preparing', 'with_courier', 'delivered', 'cancelled'] &&
      (!('scheduledDeliveryTime' in data) || (data.scheduledDeliveryTime is string && data.scheduledDeliveryTime.size() <= 100)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (incoming().role == 'employee' && incoming().walletBalance <= 500) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner updating personal delivery location and contact info (cannot change role or walletBalance)
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().walletBalance == existing().walletBalance &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'phone',
              'ministry',
              'floorNumber',
              'roomNumber',
              'avatarUrl',
              'updatedAt'
            ])
          ) ||
          // Action 2: Admin override
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection: /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (resource.data.profileId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.profileId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrderRecord(incoming()) &&
        incoming().profileId == request.auth.uid &&
        incoming().orderStatus == 'received' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrderRecord(incoming()) &&
        incoming().profileId == existing().profileId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Customer cancelling their own 'received' order before preparation
          (
            request.auth.uid == existing().profileId &&
            !(existing().orderStatus in ['delivered', 'cancelled']) &&
            existing().orderStatus == 'received' &&
            incoming().orderStatus == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt'])
          ) ||
          // Action 2: Admin managing order status
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(orderId);
    }
  }
}
