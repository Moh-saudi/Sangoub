{
  "appId": "com.el7lm.sangoub",
  "appName": "سنجوب",
  "webDir": "dist-mobile",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.run.app",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "accounts.google.com",
      "*.el7lm.com",
      "*.supabase.co",
      "*.geidea.net"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["alert", "badge", "sound"]
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "capital-talabat-key"
    }
  }
}
