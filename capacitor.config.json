{
  "appId": "eg.gov.capital.talabat",
  "appName": "طلبات الحي الحكومي بالعاصمة",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.run.app",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "accounts.google.com"
    ]
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "capital-talabat-key"
    }
  }
}
