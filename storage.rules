rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null &&
        ((('email_verified' in request.auth.token) && request.auth.token.email_verified == true) ||
          (('phone_number' in request.auth.token) && request.auth.token.phone_number != '')) &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /catalog/{collection}/{id}/{file} {
      allow read: if collection in ['stores', 'products'];
      allow create: if collection in ['stores', 'products'] && admin() &&
        request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if collection in ['stores', 'products'] && admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
